{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/api-server",
    "lib/api-zod",
    "lib/db",
    "lib/api-spec",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build --workspace=artifacts/api-server",
    "start": "node artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && tsc -p artifacts/api-server/tsconfig.json --noEmit"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
